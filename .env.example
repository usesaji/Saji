# ---------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* is inlined at BUILD time and visible in the browser —
# never put a secret behind this prefix).
# ---------------------------------------------------------------------------

# Only needed when the API is deployed separately. Same-origin by default now
# that the backend lives in this project.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SAVINGS_CONTRACT_ID=
NEXT_PUBLIC_CHALLENGE_CONTRACT_ID=
NEXT_PUBLIC_USDC_SAC=
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_USDT_SAC=
NEXT_PUBLIC_USDT_ISSUER=
NEXT_PUBLIC_XLM_SAC=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres. On serverless you need a POOLED connection string (Prisma
# Accelerate, Neon pooler, Supabase pgBouncer) — one connection per function
# instance will exhaust a direct database otherwise.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Prisma CLI only (migrate, db push, studio). Must be a DIRECT or session-mode
# connection: schema changes hold session state that the transaction pooler
# multiplexes away, so migrations through 6543 fail or misbehave.
#
# Passwords with @ ! $ % / : ? # must be percent-encoded here or the URL
# parser misreads the host.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Supabase is used ONLY as hosted Postgres — reached through Prisma above.
# This project has no supabase-js dependency and does not use Supabase Auth,
# Storage, Realtime, or RLS; auth is our own bearer tokens (src/server/auth.ts).
# The keys below are therefore NOT required to run the app. Set them only if
# you add a Supabase SDK feature later.
#
# The publishable (anon) key is safe to expose to the browser — it is
# RLS-gated by design. The SERVICE ROLE key bypasses RLS entirely: it must
# never carry a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Signs the short-lived JWT the browser uses to subscribe to its own
# notification rows over Supabase Realtime. Supabase dashboard →
# Project Settings → API → JWT Settings → JWT Secret.
#
# NO NEXT_PUBLIC_ PREFIX. This secret mints tokens for the `authenticated`
# Postgres role; exposing it to the browser would let anyone sign a token for
# any user id and read that user's notifications.
#
# Optional. Leave it blank and `/api/notifications/realtime-token` reports
# `enabled: false`, the bell falls back to refreshing on window focus, and
# nothing breaks — instant delivery is the only thing lost.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Stellar (server-side — NO NEXT_PUBLIC_ prefix; these must stay secret)
# ---------------------------------------------------------------------------

# "public" for mainnet, anything else = testnet. On mainnet every value below
# is REQUIRED and there is no testnet fallback: silently falling back means
# users transacting worthless assets while the UI calls them dollars.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=

# A funded account used ONLY as the source for read simulations. Never signs,
# never spends — but Soroban requires a valid source on the envelope.
STELLAR_READ_SOURCE=

# Signs `trigger_payout` and nothing else. Safe because the contract pays only
# the rules-determined recipient, so this key cannot redirect funds.
#
# Generate a FRESH key for mainnet. Never reuse a testnet key that has lived in
# developer environments.
STELLAR_SERVICE_SECRET=

STELLAR_USDC_SAC=
STELLAR_USDT_SAC=
STELLAR_XLM_SAC=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# MAIL_FROM_ADDRESS's domain MUST be verified in the Resend account that owns
# this key, or OTP signup fails with a 403 on every send.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Saji

# ---------------------------------------------------------------------------
# Auth / CORS
# ---------------------------------------------------------------------------

# Comma-separated allowed origins for cross-origin API calls. Leave empty for
# same-origin only. Order matters where a single redirect target is derived
# from it — the first entry wins.
# REQUIRED in production. The OAuth success redirect carries the single-use
# handoff code, and without this the base is derived from the request's Host
# header — a spoofed Host would send that code to an attacker's origin, so
# `frontendUrl()` refuses to start in production when this is empty.
# Invite links also return null without it.
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Uploads — Cloudflare R2
# ---------------------------------------------------------------------------

# TWO DIFFERENT URLS. Mixing them up is the usual failure:
#
#   - The S3 API endpoint, `https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com`,
#     is derived from R2_ACCOUNT_ID below. Every request to it must be SigV4
#     signed. The server WRITES here. It is not browsable.
#   - NEXT_PUBLIC_R2_PUBLIC_URL is a Connected Domain on the bucket, which
#     serves objects unauthenticated. The browser READS here. Pointing this at
#     the S3 endpoint gives a 401 on every image.
#
# The r2.dev subdomain works for a smoke test but is rate-limited by Cloudflare
# and unsupported for production traffic — attach a real domain.
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.yourdomain.com

# Cloudflare dashboard → R2 → (bucket) → the account id in the sidebar.
R2_ACCOUNT_ID=
R2_BUCKET=saji

# R2 → "Manage R2 API Tokens" → Create API Token → Object Read & Write, scoped
# to the bucket above. These are R2 tokens, NOT general Cloudflare API tokens.
# The secret is displayed once. Never give these a NEXT_PUBLIC_ prefix — they
# are write credentials for the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------

# Vercel sends this as `Authorization: Bearer <secret>` on scheduled runs.
# The indexer route FAILS CLOSED in production without it — otherwise the
# endpoint is a public way to make the server hammer the RPC.
CRON_SECRET=
