APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Signup OTP codes are delivered through this.
# Local dev defaults to `log` — codes are written to storage/logs/laravel.log,
# so no API key is needed to run the signup flow.
# For real delivery set MAIL_MAILER=resend and supply RESEND_API_KEY below.
# Resend for transactional email (OTP codes). Set RESEND_API_KEY below and use a
# FROM address on a domain you've verified in Resend. For local dev without a
# key, set MAIL_MAILER=log to write mail into storage/logs/laravel.log instead.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (https://resend.com/api-keys). MAIL_FROM_ADDRESS must be on a domain
# you have verified in Resend, otherwise sends are rejected.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Saji: Google OAuth (Socialite) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# --- Saji: Stellar / Soroban (Testnet) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=
# Path to the `stellar` CLI (used to assemble/simulate contract invocations).
STELLAR_CLI=stellar
# Backend scheduler key — used ONLY for trigger_payout (no user authority
# needed). NEVER a user's key. Leave blank to disable backend-initiated payouts.
STELLAR_SERVICE_SECRET=
# Default USDC Stellar Asset Contract (SAC) address on the active network.
STELLAR_USDC_SAC=
# Optional on-ramp link shown on the Wallet "Fund account" screen.
STELLAR_ONRAMP_URL=

# --- Saji: Fiat deposits via Stellar SEP-24 anchor (non-custodial) ---
# The anchor's home domain; the backend reads its stellar.toml to find the
# SEP-10 auth + SEP-24 transfer endpoints. Defaults to the testnet anchor.
STELLAR_ANCHOR_HOME_DOMAIN=testanchor.stellar.org
STELLAR_ANCHOR_ASSET_CODE=USDC

# Frontend origin(s) allowed by CORS (comma-separated)
FRONTEND_URL="http://localhost:3000,http://127.0.0.1:3000"

# --- Stellar (backend) ---
# No defaults: a missing value fails at boot rather than silently using testnet.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=
# PUBLIC address (G...) used as the source for read-only simulations.
# NEVER a secret key: CLI args are world-readable via /proc on Linux.
STELLAR_READ_SOURCE=
# Secret used ONLY for trigger_payout. Leave unset to disable backend payouts.
STELLAR_SERVICE_SECRET=
